{
  "name": "@forcecalendar/benchmark",
  "version": "2.0.0",
  "description": "Honest performance benchmarks: ForceCalendar vs FullCalendar",
  "type": "module",
  "scripts": {
    "benchmark": "node src/runner.js",
    "benchmark:bundle": "node src/benchmarks/bundle-size.js",
    "benchmark:recurrence": "node src/benchmarks/recurrence.js",
    "update-dashboard": "node src/update-dashboard.js",
    "benchmark:full": "npm run benchmark && npm run update-dashboard",
    "test": "node --test"
  },
  "dependencies": {
    "@forcecalendar/core": "2.5.7",
    "@forcecalendar/interface": "1.9.1",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/rrule": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "rrule": "2.8.1"
  },
  "devDependencies": {
    "tinybench": "2.9.0"
  }
}
